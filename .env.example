# YouTube Data API v3 Key (Server-only, nunca expor no cliente)
YOUTUBE_API_KEY=

# Limite diário de cota do YouTube (padrão: 10000 unidades)
YOUTUBE_QUOTA_DAILY_LIMIT=10000

# Teto de segurança interno da cota (0.80 = 80%, após o qual o app só responde do cache)
YOUTUBE_QUOTA_SAFETY_THRESHOLD=0.80

# URL do Banco de Dados (PostgreSQL para produção/local ou SQLite para desenvolvimento ágil)
DATABASE_URL="file:./dev.db"

# Ambiente
NODE_ENV=development

